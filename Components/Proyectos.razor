@inherits LocalizedComponentBase
@using Portfolio.Models

<section id="proyectos" class="seccion">
    <div class="file-tab">
        <span>@Loc.T("proyectos.tab")</span>
        <span class="flechaCerrar">x</span>
    </div>
    <div class="file-panel proyectosContainer reveal">
        <h1 class="titulo">@Loc.T("proyectos.titulo")</h1>
        <div class="cards-wrapper">
            @if (proyectos is null)
            {
                <p>@Loc.T("proyectos.cargando")</p>
            }
            else
            {
                @foreach (var proyecto in proyectos)
                {
                    <a href="@proyecto.Url" class="proj-card">
                        <div class="inner">

                            <div class="top-row">
                                <span class="year">@proyecto.Anio</span>
                                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="7" y1="17" x2="17" y2="7"></line>
                                    <polyline points="7 7 17 7 17 17"></polyline>
                                </svg>
                            </div>

                            <p class="title">@proyecto.Titulo</p>

                            <p class="description">@proyecto.Descripcion</p>

                            <div class="tags">
                                @foreach (var tech in proyecto.Tecnologias)
                                {
                                    var style = $"background-color: #{tech.colorHex}26; color: #{tech.colorHex};";
                                    <span class="tag" title="@tech.Nombre" style="@style">
                                        <p>@tech.Nombre</p>
                                    </span>
                                }
                            </div>

                        </div>
                    </a>
                }
            }
        </div>
    </div>
</section>

@code {
    private List<Proyecto>? proyectos;

    protected override async Task CargarDatosAsync()
    {
        var lista = await Loc.ObtenerDatosAsync<List<Proyecto>>("proyectos");

        proyectos = lista?
            .OrderByDescending(p => ParseAnio(p.Anio))
            .ToList();
    }

    private static int ParseAnio(string anio) => int.TryParse(anio, out var n) ? n : 0;
}