@inherits LocalizedComponentBase
@inject HttpClient Http
@using System.Text.Json
@using System.Linq
@using Portfolio.Models

<section id="proyectos" class="seccion">
    <div class="file-tab">
        <span>@Loc.T("proyectos.tab")</span>
        <span class="flechaCerrar">x</span>
    </div>
    <div class="file-panel proyectosContainer reveal">
        <h1 class="titulo">@Loc.T("proyectos.titulo")</h1>
        <div class="cards-wrapper">
            @if (proyectos is null)
            {
                <p>@Loc.T("proyectos.cargando")</p>
            }
            else
            {
                @foreach (var proyecto in proyectos)
                {
                    <a href="@proyecto.Url" class="proj-card">
                        <div class="inner">

                            <div class="top-row">
                                <span class="year">@proyecto.Anio</span>
                                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="7" y1="17" x2="17" y2="7"></line>
                                    <polyline points="7 7 17 7 17 17"></polyline>
                                </svg>
                            </div>

                            <p class="title">@proyecto.Titulo</p>

                            <p class="description">@proyecto.Descripcion</p>

                            <div class="tags">
                                @foreach (var tech in proyecto.Tecnologias)
                                {
                                    var style = $"background-color: #{tech.colorHex}26; color: #{tech.colorHex};";
                                    <span class="tag" title="@tech.Nombre" style="@style">
                                        <p>@tech.Nombre</p>
                                    </span>
                                }
                            </div>

                        </div>
                    </a>
                }
            }
        </div>
    </div>
</section>

@code {
    private List<Proyecto>? proyectos;

    private static readonly JsonSerializerOptions jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override void OnInitialized()
    {
        base.OnInitialized(); // ya suscribe StateHasChanged al cambio de idioma
        Loc.OnIdiomaCambiado += ManejarCambioDeIdioma;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarProyectos();
    }

    private async void ManejarCambioDeIdioma()
    {
        await CargarProyectos();
        StateHasChanged();
    }

    private async Task CargarProyectos()
    {
        var ruta = $"data/proyectos.{Loc.IdiomaActual}.json?v={DateTime.UtcNow.Ticks}";
        using var respuesta = await Http.GetAsync(ruta);
        var lista = await respuesta.Content.ReadFromJsonAsync<List<Proyecto>>(jsonOptions);

        // Orden automático: más reciente primero
        proyectos = lista?
            .OrderByDescending(p => ParseAnio(p.Anio))
            .ToList();
    }

    private static int ParseAnio(string anio) => int.TryParse(anio, out var n) ? n : 0;

    public override void Dispose()
    {
        Loc.OnIdiomaCambiado -= ManejarCambioDeIdioma;
        base.Dispose();
    }
}
