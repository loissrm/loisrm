@inherits LocalizedComponentBase
@inject HttpClient Http
@using System.Text.Json
@using Portfolio.Models


<section id="acerca" class="seccion">
    <div class="file-tab">
        <span>@Loc.T("acerca.tab")</span>
        <span class="flechaCerrar">x</span>
    </div>
    <div class="file-panel acercaContent reveal">
        <h1 class="titulo">@Loc.T("acerca.titulo")</h1>
        <h3>@Loc.T("acerca.nombre")</h3>

        <h3>@Loc.T("acerca.introTitulo")</h3>
        <p class="subtitulo">@Loc.T("acerca.introTexto")</p>

        <h3>@Loc.T("acerca.experienciaTitulo")</h3>
        @if (experiencia is not null)
        {
            <div class="timeline">
                @for (int i = 0; i < experiencia.Count; i++)
                {
                    var item = experiencia[i];
                    <div class="timeline-item">
                        <div class="timeline-marcador">
                            <span class="timeline-punto"></span>
                            @if (i < experiencia.Count - 1)
                            {
                                <span class="timeline-linea"></span>
                            }
                        </div>
                        <div class="timeline-contenido">
                            <span class="timeline-fecha">@item.FechaInicio — @item.FechaFin</span>
                            <p class="timeline-titulo">@item.Titulo</p>
                            <p class="timeline-subtitulo">@item.Subtitulo</p>
                            <p class="timeline-descripcion">@item.Descripcion</p>
                        </div>
                    </div>
                }
            </div>
        }

        <h3>@Loc.T("acerca.educacionTitulo")</h3>
        @if (educacion is not null)
        {
            <div class="timeline">
                @for (int i = 0; i < educacion.Count; i++)
                {
                    var item = educacion[i];
                    <div class="timeline-item">
                        <div class="timeline-marcador">
                            <span class="timeline-punto"></span>
                            @if (i < educacion.Count - 1)
                            {
                                <span class="timeline-linea"></span>
                            }
                        </div>
                        <div class="timeline-contenido">
                            <span class="timeline-fecha">@item.FechaInicio — @item.FechaFin</span>
                            <p class="timeline-titulo">@item.Titulo</p>
                            <p class="timeline-subtitulo">@item.Subtitulo</p>
                            <p class="timeline-descripcion">@item.Descripcion</p>
                        </div>
                    </div>
                }
            </div>
        }

        <h3>@Loc.T("acerca.educacionComplementariaTitulo")</h3>
        @if (educacionComplementaria is not null)
        {
            <div class="complementaria-grid">
                @foreach (var curso in educacionComplementaria)
                {
                    @if (string.IsNullOrEmpty(curso.Url))
                    {
                        <div class="complementaria-card">
                            <div class="complementaria-header">
                                @if (!string.IsNullOrEmpty(curso.Imagen))
                                {
                                    <img src="@curso.Imagen" alt="@curso.Titulo" class="complementaria-avatar" loading="lazy" />
                                }
                                <div>
                                    <span class="complementaria-fecha">@curso.Fecha</span>
                                    <p class="complementaria-titulo">@curso.Titulo</p>
                                </div>
                            </div>
                            <p class="complementaria-entidad">@curso.Entidad</p>
                        </div>
                    }
                    else
                    {
                        <a href="@curso.Url" target="_blank" rel="noopener" class="complementaria-card">
                            <div class="complementaria-header">
                                @if (!string.IsNullOrEmpty(curso.Imagen))
                                {
                                    <img src="@curso.Imagen" alt="@curso.Titulo" class="complementaria-avatar" loading="lazy" />
                                }
                                <div>
                                    <span class="complementaria-fecha">@curso.Fecha</span>
                                    <p class="complementaria-titulo">@curso.Titulo</p>
                                </div>
                            </div>
                            <p class="complementaria-entidad">@curso.Entidad</p>
                        </a>
                    }
                }
            </div>
        }

        <h3>@Loc.T("acerca.skillsTitulo")</h3>
        @if (habilidades is not null)
        {
            <div class="habilidades-grid">

            </div>
        }
    </div>
</section>

@code {
    private List<TimelineItem>? experiencia;
    private List<TimelineItem>? educacion;
    private List<EducacionComplementariaItem>? educacionComplementaria;
    private List<HabilidadCategoria>? habilidades;

    private static readonly JsonSerializerOptions jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override async Task OnInitializedAsync()
    {
        experiencia = await CargarAsync<TimelineItem>("data/experiencia.json");
        educacion = await CargarAsync<TimelineItem>("data/educacion.json");
        educacionComplementaria = await CargarAsync<EducacionComplementariaItem>("data/educacion-complementaria.json");
        habilidades = await CargarAsync<HabilidadCategoria>("data/habilidades.json");
    }

    private async Task<List<T>> CargarAsync<T>(string ruta)
    {
        using var respuesta = await Http.GetAsync(ruta);
        return await respuesta.Content.ReadFromJsonAsync<List<T>>(jsonOptions) ?? new List<T>();
    }
}
