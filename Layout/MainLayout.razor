@inherits LayoutComponentBase
@using Portfolio.Components
@inject LocalizationService Loc
@inject IJSRuntime JS

<div class="page @ObtenerClase()">
    <NavBar />
    <ControlesTop OnThemeChanged="CambiarTema" />

<main id="portfolio" class="portfolio" >
    @Body
</main>
</div>


@code {
    private string modoSeleccionado = "Luz";

    private void CambiarTema(bool isDark)
    {
        modoSeleccionado = isDark ? "Oscuro" : "Luz";
        StateHasChanged(); 
    }

    private string ObtenerClase() => modoSeleccionado == "Luz" ? string.Empty : "dark-mode";

    protected override async Task OnInitializedAsync()
    {
        await Loc.InicializarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // El "?v=" evita que el navegador sirva una versión vieja cacheada del módulo JS
            var module = await JS.InvokeAsync<IJSObjectReference>("import", $"./scrollspy.js?v={DateTime.UtcNow.Ticks}");
            await module.InvokeVoidAsync("iniciarScrollSpy");
        }
    }
}
