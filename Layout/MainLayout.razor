@inherits LayoutComponentBase
@using Portfolio.Components
@inject LocalizationService Loc
@inject ThemeService Theme
@implements IDisposable

@if (cargando)
{
    <div></div>
}
else
{
    <div class="page @Theme.ObtenerClaseCss()">
        <main id="portfolio" class="portfolio">
            @Body
        </main>
    </div>
}

@code {
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        Theme.OnTemaCambiado += RefrescarVista;

        try
        {
            await Loc.InicializarAsync();
            await Loc.CambiarIdiomaAsync(Loc.IdiomaActual);
            await Theme.InicializarAsync();
        }
        finally
        {
            cargando = false;
        }
    }

    private void RefrescarVista()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Theme.OnTemaCambiado -= RefrescarVista;
    }
}