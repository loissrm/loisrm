@page "/proyecto/audihub"
@inherits LocalizedComponentBase

<section class="hero">


    <a href="/#proyectos" class="btn-retro">
        <span class="btn-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-move-left">
                <path d="M6 8L2 12L6 16"/>
                <path d="M2 12H22"/>
            </svg>
        </span>
        <span>@Loc.T("proyectoDetalle.volver")</span>
    </a>

  
    <div class="hero-background">
        <div class="blob blob1"></div>
        <div class="blob blob2"></div>
        <div class="blob blob3"></div>
    </div>


    <div class="hero-content">
        <div class="hero-text">
            <span class="hero-tag">
                Proyecto Destacado
            </span>
            <h1>
                Audi<span>Hub</span>
            </h1>
            <p class="hero-description">
                Una plataforma diseñada para gestionar, organizar y disfrutar
                de bibliotecas musicales desde cualquier dispositivo.
                Desarrollada en <strong>HTML, CSS y JavaScript</strong> para la versión web y
                <strong>Android Studio</strong> para la aplicación móvil,
                compartiendo una misma infraestructura basada en Firebase.
            </p>


            <div class="hero-techs">
                <span class="tech-html">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4.7 2.2l1.6 17.5 5.7 1.6 5.7-1.6 1.6-17.5H4.7z"/>
                        <path d="M12 7h3.5l-.3 3.5H12v3.5h3l-.3 3.5-2.7.7-2.7-.7-.2-2H7.6l.3 5L12 21.5l4.1-1.1.7-8.4H12V7z"/>
                    </svg>
                    HTML
                </span>
                <span class="tech-css">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4.7 2.2l1.6 17.5 5.7 1.6 5.7-1.6 1.6-17.5H4.7z"/>
                        <path d="M12 7h3.5l-.7 7.5-2.8.8-2.8-.8-.2-2H7.6l.3 4.5 4.1 1.1 4.1-1.1 1.1-11.5H12V7z"/>
                    </svg>
                    CSS
                </span>
                <span class="tech-js">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3h18v18H3V3z"/>
                        <path d="M15 15h1.5a1.5 1.5 0 0 1 1.5 1.5v0a1.5 1.5 0 0 1-1.5 1.5H15"/>
                        <path d="M10 15a1 1 0 0 0-1-1h-1a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2z"/>
                    </svg>
                    JavaScript
                </span>
                <span class="tech-firebase">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3.89 15.75L5.43 5.92c.07-.46.36-.85.78-.99.41-.14.88 0 1.17.34l3.19 3.66 4.96-9.11c.21-.38.61-.62 1.05-.62s.84.24 1.05.62l4.47 8.21zM13.2 9.53l-2.45-2.81-6.19 11.23zM20.08 17.91l-3.32-6.19-2.22 4.12 3.19 1.83c.71.41 1.59.17 2.01-.52.17-.28.22-.61.15-.93a1.762 1.762 0 0 0-.19.53zM16.94 11.19l-3.32-6.19c-.21-.38-.61-.62-1.05-.62s-.84.24-1.05.62l-2.07 3.82 2.05 11.62z"/>
                    </svg>
                    Firebase
                </span>
                <span class="tech-android">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 18c0 .55.45 1 1 1h1v3c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-3h2v3c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-3h1c.55 0 1-.45 1-1V9H6v9z"/>
                        <path d="M5 14v-4c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v4c0 .55.45 1 1 1h1c.55 0 1-.45 1-1z"/>
                        <path d="M19 14v-4c0-.55.45-1 1-1h1c.55 0 1 .45 1 1v4c0 .55-.45 1-1 1h-1c-.55 0-1-.45-1-1z"/>
                        <path d="M16.24 7.76C15.07 6.59 13.54 6 12 6s-3.07.59-4.24 1.76L6 9h12l-1.76-1.24z"/>
                        <line x1="9" y1="3" x2="10" y2="5"/>
                        <line x1="15" y1="3" x2="14" y2="5"/>
                    </svg>
                    Android Studio
                </span>
            </div>


            <div class="hero-buttons">
                <a class="btn-primary" href="#overview">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play">
                        <polygon points="6 3 20 12 6 21 6 3"/>
                    </svg>
                    <span>Vídeo Web</span>
                </a>
                <a class="btn-primary" href="#overview">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play">
                        <polygon points="6 3 20 12 6 21 6 3"/>
                    </svg>
                    <span>Vídeo Móvil</span>
                </a>
                <a class="btn-secondary" href="https://github.com/TU-USUARIO" target="_blank" rel="noopener noreferrer">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                        <path d="M9 18c-4.51 2-5-2-7-2"/>
                    </svg>
                    <span>Github</span>
                </a>
            </div>
        </div>


        <div class="hero-image">
            <div class="image-card">
                <img src="images/audihub/hero.webp" alt="AudiHub"/>
            </div>
        </div>
    </div>

    <div class="hero-scroll">
        <span>Descubre más</span>
        <div class="scroll-indicator">
            <div></div>
        </div>
    </div>
</section>