    <section class="details-section">
        <div class="section-header">
            <span class="section-badge">@Loc.TP("funcionalidades")</span>
            <h2>@Loc.TP("funcionalidadesTitutlo")</h2>
            <p class="section-subtitle">@Loc.TP("funcionalidadesDes")</p>
        </div>
        
        <div class="funcionalidades">
            <div class="funcionalidades-web">
                <h3>@Loc.TP("funcionalidadesWebTitutlo")</h3>
                <li>
                    <ul>@Loc.TP("funcionalidadesWeb1")</ul>
                    <ul>@Loc.TP("funcionalidadesWeb2")</ul>
                    <ul>@Loc.TP("funcionalidadesWeb3")</ul>
                </li>
            </div>

            <div class="funcionalidades-generales">
                <h3>@Loc.TP("funcionalidadesGeneralesTitutlo")</h3>
                <li>
                    <ul>@Loc.TP("funcionalidadesGenerales1")</ul>
                    <ul>@Loc.TP("funcionalidadesGenerales2")</ul>
                    <ul>@Loc.TP("funcionalidadesGenerales3")</ul>
                </li>
            </div>
            
            <div class="funcionalidades-movil">
                <h3>@Loc.TP("funcionalidadesMovilTitutlo")</h3>
