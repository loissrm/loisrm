<!-- SCREENSHOTS -->
<section class="screens" id="screens">
    <div class="section-inner">
        <p class="section-label">@Loc.TP("screens.label")</p>
        <h2>@Loc.TP("screens.titulo")</h2>
        <!-- Cambiado a .screens-grid para coincidir con el CSS -->
        <div class="screens-grid">
            <figure class="screen-frame shot-1">
                <img src="/img/proyectos/FrogJumping/EscenaNiveñesFrogJumping.png" alt="@Loc.TP("screens.alt1")" loading="lazy">
            </figure>
            <figure class="screen-frame shot-2">
                <img src="/img/proyectos/FrogJumping/EscenaNivelFrogJumping.png" alt="@Loc.TP("screens.alt2")" loading="lazy">
            </figure>
            <figure class="screen-frame shot-3">
                <img src="/img/proyectos/FrogJumping/EscenaPausaFrogJumping.png" alt="@Loc.TP("screens.alt3")" loading="lazy">
            </figure>
            <figure class="screen-frame shot-4">
                <img src="/img/proyectos/FrogJumping/EscenaFinalNivel1FrogJumping.png" alt="@Loc.TP("screens.alt4")" loading="lazy">
            </figure>
            <figure class="screen-frame shot-5">
                <img src="/img/proyectos/FrogJumping/Nivel1CompletadoFrogJumping.png" alt="@Loc.TP("screens.alt5")" loading="lazy">
            </figure>
        </div>
    </div>
</section>

<!-- PLAY -->
<section class="play" id="play">
    <div class="section-inner">
        <h2>@Loc.TP("play.titulo")</h2>
        <p class="lead">@Loc.TP("play.texto")</p>
        <div class="cta-row" style="justify-content:center;">
            <a href="https://play.unity.com/en/games/e5673c1d-d70c-4746-9b82-5031c6c83e4b/webgl-builds" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <path fill="currentColor" d="M8 5.14v14l11-7z" />
                </svg>
                @Loc.TP("play.botonJugar")
            </a>
        </div>
        <div class="platform-row">
            <span class="platform-chip">@Loc.TP("play.plataforma1")</span>
            <span class="platform-chip">@Loc.TP("play.plataforma2")</span>
        </div>
    </div>
</section>

<footer>
    <div class="footer-links">
        <a href="/#proyectos">@Loc.TP("topbar.volver")</a>
        <a href="https://github.com/loissrm/DAM_UF2_Proyecto.git" target="_blank" rel="noopener noreferrer">@Loc.TP("repositorio")</a>
        <a href="https://play.unity.com/en/games/e5673c1d-d70c-4746-9b82-5031c6c83e4b/webgl-builds">@Loc.TP("footer.jugar")</a>
    </div>
    &copy; @DateTime.Now.Year Lois Rodríguez Moimenta. @Loc.T("footer.derechos").
</footer>

@code {    protected override async Task CargarDatosAsync()
    {
        await Loc.CargarTraduccionesProyectoAsync("FrogJumping");
    }

    public override void Dispose()
    {
        base.Dispose();
        Loc.LimpiarProyectoActual();
    }
}
