@page "/proyecto/frogJumping"
@inherits LocalizedComponentBase

<PageTitle>Proyecto · Frog Jumping</PageTitle>
<HeadContent>
    <meta name="description" content="@Loc.T("proyectoDetalle.descripcion.FrogJumping")" />
    <meta property="og:title" content="Frog Jumping · Lois Rodríguez Moimenta" />
    <meta property="og:description" content="@Loc.T("proyectoDetalle.descripcion.FrogJumping")" />
    <meta property="og:image" content="https://loisrm.pages.dev/img/proyectos/FrogJumping/EscenaIncioFrogJumping.png" />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Baloo+2:wght@500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
</HeadContent>

<div class="topbar">
    <a href="/#proyectos" class="pixel-btn back" aria-label="@Loc.TP("topbar.volver")">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <path d="M15 18l-6-6 6-6" />
        </svg>
        <span class="label">@Loc.TP("topbar.volver")</span>
    </a>
    <a href="https://github.com/loissrm/DAM_UF2_Proyecto.git" target="_blank" rel="noopener noreferrer" class="pixel-btn repo" aria-label="@Loc.TP("topbar.repositorio")">
        <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.6.5.7 5.4.7 11.8c0 5.1 3.3 9.4 7.9 11 .6.1.8-.3.8-.6v-2.2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11 11 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.6 7.9-5.9 7.9-11C23.3 5.4 18.4.5 12 .5z" />
        </svg>
        <span class="label">@Loc.TP("repositorio")</span>
    </a>
</div>

<!-- HERO -->
<header class="hero">
    <div class="cloud cloud-a"></div>
    <div class="cloud cloud-b"></div>
    <div class="cloud cloud-c"></div>
    <div class="mountain m1"></div>
    <div class="mountain m2"></div>

    <div class="hero-inner">
        <div class="hero-copy">
            <span class="eyebrow">@Loc.TP("hero.eyebrow")</span>
            <h1 class="title"><span class="frog">@Loc.TP("hero.tituloFrog")</span> <span class="jumping">@Loc.TP("hero.tituloJumping")</span></h1>
            <p class="subtitle">@Loc.TP("hero.subtitulo")</p>
            <div class="cta-row">
                <a href="https://play.unity.com/en/games/e5673c1d-d70c-4746-9b82-5031c6c83e4b/webgl-builds" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="currentColor" d="M8 5.14v14l11-7z" />
                    </svg>
                    @Loc.TP("hero.botonJugar")
                </a>
                <a href="/proyecto/frogJumping#screens" class="btn btn-secondary" >@Loc.TP("hero.botonCapturas")</a>
            </div>
            <p class="blink-line">@Loc.TP("hero.blink")</p>
        </div>

        <div class="console">
            <div class="console-frame">
                <div class="console-screen">
                    <img src="/img/proyectos/FrogJumping/EscenaIncioFrogJumping.png" alt="@Loc.TP("hero.capturaAlt")" loading="eager">
                </div>
                <div class="console-dots"><span></span><span></span><span></span></div>
            </div>
        </div>
    </div>
</header>

<div class="grass-edge"><div class="dirt-fill"></div></div>

<!-- ABOUT -->
<section class="about" id="about">
    <div class="section-inner about-grid">
        <div>
            <p class="section-label">@Loc.TP("about.label")</p>
            <h2>@Loc.TP("about.titulo1")<br>@Loc.TP("about.titulo2")</h2>
            <p class="lead">@Loc.TP("about.texto")</p>
        </div>
        <div class="stat-grid">
            <div class="stat-card"><span class="stat-num">1</span><span class="stat-label">@Loc.TP("about.stat1Label")</span></div>
            <div class="stat-card"><span class="stat-num">5</span><span class="stat-label">@Loc.TP("about.stat2Label")</span></div>
            <div class="stat-card"><span class="stat-num">2D</span><span class="stat-label">@Loc.TP("about.stat3Label")</span></div>
            <div class="stat-card"><span class="stat-num">PC</span><span class="stat-label">@Loc.TP("about.stat4Label")</span></div>
        </div>
    </div>
</section>

