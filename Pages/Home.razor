@page "/"
@using Portfolio.Components
@inherits LocalizedComponentBase
@inject IJSRuntime JS

<PageTitle>Lois Rodríguez Moimenta · Portfolio</PageTitle>
<HeadContent>
    <meta name="description" content="@Loc.T("portfolio.descripcion")" />
    <meta property="og:title" content="Lois Rodríguez Moimenta · Portfolio" />
    <meta property="og:description" content="@Loc.T("portfolio.descripcion")" />
    <meta property="og:image" content=".\img\imagenPerfil\perfil.jpeg" />
    <meta property="og:type" content="website" />
</HeadContent>
<NavBar />

<div class="secciones">
    <Inicio />
    <SobreMi />
    <Proyectos/>
    <Contacto/>
</div>

<Footer/>


@code{
        protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // El "?v=" evita que el navegador sirva una versión vieja cacheada del módulo JS
            var module = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/scrollspy.js?v={DateTime.UtcNow.Ticks}");
            await module.InvokeVoidAsync("iniciarScrollSpy");
        }
    }
}
